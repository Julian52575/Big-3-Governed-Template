{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon -L src/server.js",
    "start": "node src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "oxlint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.3.0",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "oxlint": "^1.89.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/spec/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ]
  }
}
