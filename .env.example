# Copy to .env and adjust. Loaded by the Nix dev shell and by every `just`
# recipe (`set dotenv-load`). Keep secrets out of git -- .env is ignored.

# Host ports the Traefik proxy publishes: HTTP entrypoint and dashboard.
PROXY_PORT=8000
PROXY_DASHBOARD_PORT=8080

# Override where rootless Podman keeps its image/container storage.
# Leave unset to use ./.containers -- or, when the project lives on a
# network/virtualised filesystem (e.g. WSL2 drvfs), an auto-picked path
# under $HOME (~/.cache/podman-storage/<project>).
# PODMAN_STORAGE_DIR=/home/you/.cache/podman-storage/myproject

# Set to 1 to stop the dev shell from starting a Podman API socket
# (useful in CI or headless environments).
# PODMAN_NO_SOCKET=1
